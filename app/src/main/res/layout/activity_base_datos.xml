<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingTop="40dp"
    android:paddingBottom="24dp"
    android:background="#F4F7FB">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Administración"
        android:textSize="14sp"
        android:textAllCaps="true"
        android:letterSpacing="0.1"
        android:textColor="#0277BD"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Visor de SQLite"
        android:textSize="32sp"
        android:textStyle="bold"
        android:textColor="#102A43"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="24dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp"
        android:gravity="center_vertical">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="#BCCCDC"
            app:cardBackgroundColor="#FFFFFF"
            android:layout_marginEnd="12dp">

            <androidx.appcompat.widget.AppCompatSpinner
                android:id="@+id/spTablas"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingHorizontal="12dp"
                android:background="@android:color/transparent" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCargarTabla"
            android:layout_width="wrap_content"
            android:layout_height="64dp"
            android:text="Consultar"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="15sp"
            app:cornerRadius="12dp"
            app:backgroundTint="#0277BD"
            app:elevation="2dp"
            android:insetTop="0dp"
            android:insetBottom="0dp" />
    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp"
        app:strokeWidth="0dp"
        app:cardBackgroundColor="#FFFFFF"
        android:layout_marginBottom="24dp">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp"
            android:scrollbars="vertical"
            android:clipToPadding="false">

            <TextView
                android:id="@+id/tvDatosRaw"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Seleccione una tabla para visualizar..."
                android:textSize="14sp"
                android:fontFamily="monospace"
                android:textColor="#334E68"
                android:lineSpacingExtra="6dp" />

        </ScrollView>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnVolver"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="Volver al Menú"
        android:textColor="#486581"
        android:textSize="15sp"
        android:textAllCaps="false"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        app:cornerRadius="12dp"
        app:strokeColor="#BCCCDC"
        app:strokeWidth="1dp" />

</LinearLayout>