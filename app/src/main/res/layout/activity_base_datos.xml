<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@android:color/white">

    <!-- Encabezado -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Inspección de Base de Datos SQLite"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@android:color/black"
        android:layout_marginBottom="24dp" />

    <!-- Selector de Tabla -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">

        <Spinner
            android:id="@+id/spTablas"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:padding="8dp"
            android:background="@android:drawable/spinner_background" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCargarTabla"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Consultar Tabla"
            android:textAllCaps="false"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            app:cornerRadius="8dp"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <!-- Contenedor de Visores (ScrollView con TextView) -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#F5F5F5"
        android:padding="12dp"
        android:layout_marginBottom="16dp"
        android:scrollbars="vertical">

        <TextView
            android:id="@+id/tvDatosRaw"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Seleccione una tabla para visualizar..."
            android:textSize="14sp"
            android:fontFamily="monospace"
            android:textColor="@android:color/black"
            android:lineSpacingExtra="4dp" />

    </ScrollView>

    <!-- Botón Volver al Menú -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnVolver"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Volver al Menú"
        android:textAllCaps="false"
        android:padding="12dp"
        app:cornerRadius="8dp"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

</LinearLayout>