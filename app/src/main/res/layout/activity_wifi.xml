<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F4F7FB"> <!-- Mismo fondo de la aplicación -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="40dp"
        android:paddingBottom="24dp"
        android:clipToPadding="false">

        <!-- Etiqueta superior -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Diagnóstico de red"
            android:textSize="14sp"
            android:textAllCaps="true"
            android:letterSpacing="0.1"
            android:textColor="#0277BD"
            android:textStyle="bold" />

        <!-- Encabezado alineado a la izquierda -->
        <TextView
            android:id="@+id/tvTituloWifi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Monitoreo WiFi"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="#102A43"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="32dp" />

        <!-- Tarjeta de información blanca -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:strokeWidth="0dp"
            app:cardBackgroundColor="#FFFFFF"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <!-- SSID (Resaltado como el dato principal) -->
                <TextView
                    android:id="@+id/tvSsid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="SSID: --"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#102A43" />

                <!-- Línea divisoria sutil -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E2E8F0"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp"/>

                <!-- BSSID -->
                <TextView
                    android:id="@+id/tvBssid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="BSSID: --"
                    android:textSize="15sp"
                    android:textColor="#334E68" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E2E8F0"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp"/>

                <!-- Dirección IP -->
                <TextView
                    android:id="@+id/tvIp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="IP: --"
                    android:textSize="15sp"
                    android:textColor="#334E68" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E2E8F0"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp"/>

                <!-- Frecuencia -->
                <TextView
                    android:id="@+id/tvFrecuencia"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Frecuencia: --"
                    android:textSize="15sp"
                    android:textColor="#334E68" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E2E8F0"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp"/>

                <!-- Velocidad de Enlace -->
                <TextView
                    android:id="@+id/tvVelocidad"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Velocidad: --"
                    android:textSize="15sp"
                    android:textColor="#334E68" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E2E8F0"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp"/>

                <!-- Intensidad de Señal/RSSI -->
                <TextView
                    android:id="@+id/tvIntensidad"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Intensidad: --"
                    android:textSize="15sp"
                    android:textColor="#334E68" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E2E8F0"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp"/>

                <!-- Estado de Conexión (Resaltado en azul) -->
                <TextView
                    android:id="@+id/tvEstado"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Estado: --"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#0277BD" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Espaciador para empujar los botones hacia el fondo -->
        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Botón Actualizar (Principal) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnActualizar"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:text="Actualizar Información"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textAllCaps="false"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:cornerRadius="16dp"
            app:backgroundTint="#0277BD"
            app:elevation="4dp"
            android:layout_marginBottom="16dp" />

        <!-- Botón Volver (Secundario) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVolver"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Volver al Menú"
            android:textColor="#486581"
            android:textSize="15sp"
            android:textAllCaps="false"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:cornerRadius="12dp"
            app:strokeColor="#BCCCDC"
            app:strokeWidth="1dp" />

    </LinearLayout>
</ScrollView>