<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F4F7FB">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="40dp"
        android:paddingBottom="24dp"
        android:clipToPadding="false">


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ubicación y Rastreo"
            android:textSize="14sp"
            android:textAllCaps="true"
            android:letterSpacing="0.1"
            android:textColor="#0277BD"
            android:textStyle="bold" />


        <TextView
            android:id="@+id/tvTituloUbicacion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Geolocalización GPS"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="#102A43"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="32dp" />


        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:strokeWidth="0dp"
            app:cardBackgroundColor="#FFFFFF"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">


                <TextView
                    android:id="@+id/tvLatitud"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Latitud: --"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#102A43" />


                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E2E8F0"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp"/>


                <TextView
                    android:id="@+id/tvLongitud"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Longitud: --"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#102A43" />


                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E2E8F0"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp"/>


                <TextView
                    android:id="@+id/tvAltitud"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Altitud: --"
                    android:textSize="15sp"
                    android:textColor="#334E68" />


                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E2E8F0"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp"/>


                <TextView
                    android:id="@+id/tvPrecision"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Precisión: --"
                    android:textSize="15sp"
                    android:textColor="#334E68" />


                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E2E8F0"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp"/>


                <TextView
                    android:id="@+id/tvVelocidad"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Velocidad: --"
                    android:textSize="15sp"
                    android:textColor="#334E68" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>


        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />


        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnObtenerUbicacion"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:text="Actualizar Coordenadas"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textAllCaps="false"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:cornerRadius="16dp"
            app:backgroundTint="#0277BD"
            app:elevation="4dp"
            android:layout_marginBottom="16dp" />


        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVolver"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Volver al Menú"
            android:textColor="#486581"
            android:textSize="15sp"
            android:textAllCaps="false"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:cornerRadius="12dp"
            app:strokeColor="#BCCCDC"
            app:strokeWidth="1dp" />

    </LinearLayout>
</ScrollView>